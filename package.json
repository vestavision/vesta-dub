{
  "name": "vesta-dub",
  "version": "0.1.0",
  "description": "YouTube videolarını Türkçe dinle. Altyazılardan seslendirme, iki Türkçe ses ve videoya uyum sağlayan konuşma hızı.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-bergamot.mjs && wxt",
    "build": "node scripts/sync-bergamot.mjs && wxt build",
    "zip": "wxt zip",
    "prepare": "wxt prepare",
    "compile": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "package:release": "node scripts/package-release.mjs",
    "test:browser:native": "npm run build && node scripts/p5.1-extension-integration.mjs",
    "test:browser:brave": "npm run build && node scripts/p5.1-brave-recovery.mjs"
  },
  "dependencies": {
    "@browsermt/bergamot-translator": "^0.4.9",
    "onnxruntime-web": "^1.21.0",
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.0.0",
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.0",
    "onnxruntime-node": "^1.30.0",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "wxt": "^0.21.4"
  }
}
